# Backend config. Copy to .env and adjust.

# MariaDB (MySQL) database. Database name is `mycv`.
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/mycv
# User & password dibikin lewat setup_db.sql (jalanin sekali sebagai root).
# Ganti GANTI_PASSWORD dengan password asli kamu di file .env (bukan di sini).
DATABASE_URL=mysql+pymysql://gwuser:GANTI_PASSWORD@127.0.0.1:3306/mycv

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email kamu (dipakai bot & footer)
CONTACT_EMAIL=tamam.niamillah.rpw@gmail.com

# Opsional: buat kirim notifikasi pertanyaan "pending" ke email kamu.
# Gmail: smtp.gmail.com, port 587, user = email kamu.
# password pakai "App Password" (butuh 2-Step Verification di akun Google).
#
# JANGAN nulis App Password mentah di SMTP_PASSWORD.
# Encode dulu:  .venv/bin/python encode_password.py
# terus hasilnya taruh di SMTP_PASSWORD_B64 (baris di bawah).
# File .env ini sudah di-gitignore, jangan pernah di-share.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_B64=

# Admin halaman /admin (khusus kamu).
# Username bebas. Password JANGAN isi mentah.
# Bikin hash-nya dulu:  .venv/bin/python create_admin_password.py
ADMIN_USERNAME=ganteng
ADMIN_PASSWORD_HASH=